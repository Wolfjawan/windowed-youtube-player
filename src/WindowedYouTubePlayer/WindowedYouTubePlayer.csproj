<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WindowedStreamingPlayer</AssemblyName>
    <RootNamespace>WindowedYouTubePlayer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>0.5.4</Version>
    <AssemblyVersion>0.5.4.0</AssemblyVersion>
    <FileVersion>0.5.4.0</FileVersion>
    <Product>Windowed Streaming Player</Product>
    <Description>Open streaming websites in resizable Chromium app windows with enforced window-only video fullscreen.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="MainForm.cs" />
    <Compile Include="BrandUi.cs" />
    <Compile Include="BrowserSetup.cs" />
    <Compile Include="SiteSetup.cs" />
    <Compile Include="BrowserProfilePolicy.cs" />
    <Compile Include="BrowserControl.cs" />
    <Compile Include="FullscreenInjection.cs" />
    <Compile Include="FullscreenSafetyInjection.cs" />
    <Compile Include="FullscreenScripts.cs" />
  </ItemGroup>
</Project>
